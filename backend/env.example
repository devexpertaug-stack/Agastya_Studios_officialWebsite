# ------------------------------------------------------------------
# Agastya Studios — backend environment
# Copy this file to `.env` (in the backend/ folder) and fill in values.
# The app now runs entirely on MongoDB + a standard LLM provider.
# (No Emergent account or EMERGENT_LLM_KEY required anymore.)
# ------------------------------------------------------------------

# --- Database (MongoDB) ---
# Local:   mongodb://localhost:27017
# Atlas:   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGO_URL=mongodb://localhost:27017
DB_NAME=agastya_studios

# --- Auth / admin login ---
# JWT_SECRET: use a long random string in production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@agastyastudios.com
ADMIN_PASSWORD=change-me

# --- Rishi chatbot (LLM provider) ---
# Pick one provider. Rishi keeps working as long as a valid key is set.
# If left blank, the site still runs and the chat degrades gracefully.
LLM_PROVIDER=openai            # "openai" or "anthropic"

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # optional override

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Max tokens per reply (optional)
LLM_MAX_TOKENS=400

# --- CORS ---
# Comma-separated list of allowed origins, or * for all.
CORS_ORIGINS=*
